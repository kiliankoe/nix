{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(bun run build:*)",
      "Bash(bun run check:*)",
      "Bash(bun run format:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run tsc:*)",
      "Bash(bun test:*)",
      "Bash(bunx biome:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run format:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run tsc:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm tsc:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab ci list:*)",
      "Bash(glab ci view:*)",
      "Bash(glab ci status:*)",
      "Bash(glab ci trace:*)",
      "Bash(glab pipeline list:*)",
      "Bash(glab repo view:*)",
      "Bash(glab repo contributors:*)",
      "Bash(glab release list:*)",
      "Bash(glab release view:*)",
      "Bash(glab label list:*)",
      "Bash(glab milestone list:*)",
      "Bash(glab auth status:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(glab repo delete:*)",
      "Bash(glab release delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "askUserQuestionTimeout": "never",
  "preferredNotifChannel": "ghostty"
}
